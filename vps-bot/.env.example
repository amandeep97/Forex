# ── News direction (optional) ─────────────────────────────────────────────────
#
# Free key from console.groq.com. With it, each new headline is read by a model
# and labelled bullish, bearish or unclear FOR THE INSTRUMENTS IT MENTIONS, with
# a short reason — which a keyword list can never do, because "OPEC raises
# output" and "OPEC cuts output" are the same words and opposite trades.
#
# Only headlines never seen before are sent, batched, at most twice per news
# cycle: roughly a hundred and fifty requests a day.
#
# The labels are treated as unproven. They are archived beside the headline so a
# study can ask, in a few weeks, what actually followed the ones called bearish.
# If the answer is nothing, the direction comes off the cards.
#
# Unset means no labels and no requests. Everything else works as before.
GROQ_API_KEY=

# ── Bot ───────────────────────────────────────────────────────────────────────
BOT_INTERVAL_MS=60000
LOG_LEVEL=info


# ── The silver desk (live orders, with your approval) ────────────────────────
#
# OFF unless this says exactly "on". It is the only thing in this bot that
# places an order you did not type yourself, so it does not come on because a
# deploy arrived — you turn it on deliberately, on the box, and restart.
#
# What it does: when silver takes a level and the plan arms, it sizes the trade
# to XAG_RISK_USD and sends you a proposal with PLACE / SKIP buttons. Nothing
# reaches OANDA until you tap, or approve it in the app. The proposal dies in an
# hour if you do not answer; the order it places carries an 8h expiry at the
# venue so it cannot outlive the plan that justified it.
#
# It trades silver and nothing else. That is hard-coded, not read from here.
#
# TWO KEYS. This flag only PERMITS a desk; arming it, and changing the risk and
# the limits, is done in the app's Auto Trading tab and takes effect on the next
# tick with no restart. The app can never arm a desk this says off.
#
# That is not belt-and-braces. The app writes to a public repo with a token, and
# that same token can already approve a trade. If the app could arm the desk
# too, the token alone would be enough for the whole path from nothing to a live
# order. This flag is the one lock a leaked token cannot pick.
XAG_DESK=off

# The starting risk, before the app has ever written a setting. After that the
# app's value wins, bounded by XAG_MAX_RISK_USD below.
XAG_RISK_USD=3

# The ceiling the app cannot type past. Leave it unset for the built-in $25.
# Set it low while you are still watching the first few trades.
# XAG_MAX_RISK_USD=5

# Who may approve. Defaults to TELEGRAM_CHAT_ID, which in a private chat is your
# own user id. Set it explicitly if the bot posts into a GROUP — there, the chat
# id is the group's and anyone in it could otherwise tap the button.
# TELEGRAM_OWNER_ID=123456789
