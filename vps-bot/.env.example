# ── OANDA ────────────────────────────────────────────────────────────────────
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_PRACTICE=true          # true = practice/demo, false = live
                             # This is not only a data setting: it decides where
                             # ORDERS GO. Leave it true unless you mean to trade
                             # a funded account.

# Optional, and only for the retail position book.
#
# OANDA serves /instruments/{x}/positionBook on the LIVE host only — on the
# practice API every instrument returns 401, which is the demo host declining
# to serve that data rather than a missing permission. That book is the one
# genuine sentiment reading available here: where OANDA's own clients actually
# sit, rather than a number inferred from the same candles everyone has.
#
# A token from a live account, used by exactly one endpoint on the live host,
# while everything else — including all trading — stays wherever
# OANDA_PRACTICE points it. The client refuses to send this token to any path
# that is not an instrument read, so it cannot reach an account endpoint.
#
# Unset means the position book is simply not recorded. Nothing else changes.
OANDA_BOOK_API_KEY=

